{
    "name": "fake-http-server",
    "version": "1.0.2",
    "description": "A fake web server who sends static data",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build/**/*"
    ],
    "scripts": {
        "format": "prettier ./ --write",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build": "tsc",
        "build:force": "rm -rf \"./build\" && tsc",
        "start": "node --env-file=.env ./build/index.js",
        "start:watch": "ts-node-dev --respawn --env-file=.env ./src/index.ts",
        "test": "ts-node-dev --env-file=.env ./tests/index.test.ts",
        "test:watch": "ts-node-dev --respawn --env-file=.env ./tests/index.test.ts"
    },
    "keywords": [],
    "author": {
        "name": "Danny Vaca",
        "email": "danny270793@gmail.com",
        "url": "https://danny270793.github.io/#/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/danny270793/Fake-HTTP-Server.git"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "eslint": "^9.9.0",
        "global": "^4.4.0",
        "prettier": "^3.3.3",
        "ts-node-dev": "^2.0.0",
        "ts-node-test": "^0.4.4",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.0.1"
    }
}
